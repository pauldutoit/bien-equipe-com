---
// Vidéo YouTube « légère » : miniature hébergée chez nous, lecteur (youtube-nocookie) chargé au clic.
// Rien n'est demandé à YouTube tant que le visiteur ne lance pas la vidéo (performance + RGPD).
interface Props { youtubeId: string; title: string }
const { youtubeId, title } = Astro.props;
---
<div class="yt" data-yt={youtubeId}>
  <button type="button" class="yt-play" aria-label={`Lire la vidéo : ${title}`}>
    <img src={`/videos/${youtubeId}.webp`} alt={`Miniature de la vidéo : ${title}`} width="1280" height="720" loading="lazy" decoding="async" />
    <span class="yt-btn" aria-hidden="true">
      <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.6 8.6 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.6 8.6 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.6 8.6 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.6 8.6 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#3b5bff"/><path d="M45 24 27 14v20z" fill="#fff"/></svg>
    </span>
  </button>
  <p class="small muted yt-note">La lecture charge le lecteur YouTube (mode sans cookie publicitaire). <a href={`https://www.youtube.com/watch?v=${youtubeId}`} target="_blank" rel="noopener">Voir sur YouTube</a></p>
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-yt]").forEach((box) => {
    box.querySelector("button")?.addEventListener("click", () => {
      const id = box.dataset.yt!;
      const f = document.createElement("iframe");
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      f.title = box.querySelector("img")?.alt.replace("Miniature de la vidéo : ", "") || "Vidéo";
      f.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      f.allowFullscreen = true;
      f.className = "yt-frame";
      box.querySelector("button")!.replaceWith(f);
    });
  });
</script>
<style>
  .yt { max-width: 760px; }
  .yt-play, .yt :global(.yt-frame) { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; padding: 0; border-radius: var(--radius); overflow: hidden; background: #000; position: relative; cursor: pointer; }
  .yt-play img { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity .2s; }
  .yt-play:hover img { opacity: .9; }
  .yt-btn { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .yt-note { margin: 8px 0 0; }
</style>
