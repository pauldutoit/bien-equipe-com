---
// Silhouettes de face, à la même échelle, avec une personne de 1,70 m pour repère.
import { type Fridge, fmt } from "../lib/catalog";
const { items } = Astro.props as { items: Fridge[] };
const maxH = Math.max(205, ...items.map((f) => f.height));
const scale = 1.2; // px par cm
const gap = 26;
const person = 170;
const H = maxH * scale + 40;
let x = 20;
const shapes = items.map((f, i) => {
  const w = f.width * scale, h = f.height * scale;
  const s = { f, x, y: H - 20 - h, w, h, i };
  x += w + gap;
  return s;
});
const px = x + 10;
const W = px + 50;
const colors = ["#3b5bff", "#ffd23f", "#1f9d6b", "#d64545"];
---
<figure class="sil">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparaison des dimensions, à l'échelle">
    <line x1="0" x2={W} y1={H - 20} y2={H - 20} stroke="#c9cee3" />
    {shapes.map((s) => {
      const freezerH = s.f.freezerVolume > 0 && s.f.type !== "une-porte" ? s.h * Math.min(0.45, s.f.freezerVolume / s.f.totalVolume + 0.06) : 0;
      const top = s.f.type === "deux-portes";
      return (
        <g>
          <rect x={s.x} y={s.y} width={s.w} height={s.h} rx="6" fill="#fff" stroke={colors[s.i % 4]} stroke-width="2.5" />
          {s.f.type === "americain" || s.f.type === "multiportes" ? (
            <line x1={s.x + s.w / 2} x2={s.x + s.w / 2} y1={s.y} y2={s.f.type === "multiportes" ? s.y + s.h * 0.55 : s.y + s.h} stroke={colors[s.i % 4]} stroke-width="1.5" />
          ) : null}
          {freezerH > 0 && s.f.type !== "americain" ? (
            <line x1={s.x} x2={s.x + s.w} y1={top ? s.y + freezerH : s.y + s.h - freezerH} y2={top ? s.y + freezerH : s.y + s.h - freezerH} stroke={colors[s.i % 4]} stroke-width="1.5" />
          ) : null}
          <text x={s.x + s.w / 2} y={s.y - 8} text-anchor="middle" font-size="11" font-weight="700" fill="#161a33">{fmt(s.f.height)} cm</text>
          <text x={s.x + s.w / 2} y={H - 5} text-anchor="middle" font-size="11" fill="#5d6380">{fmt(s.f.width, s.f.width % 1 ? 1 : 0)} cm</text>
        </g>
      );
    })}
    <g transform={`translate(${px} ${H - 20 - person * scale})`} fill="#c9cee3">
      <circle cx="15" cy={12} r={11} />
      <rect x="4" y={26} width="22" height={person * scale * 0.42} rx="9" />
      <rect x="6" y={26 + person * scale * 0.4} width="8" height={person * scale * 0.48} rx="4" />
      <rect x="16" y={26 + person * scale * 0.4} width="8" height={person * scale * 0.48} rx="4" />
    </g>
    <text x={px + 15} y={H - 25 - person * scale - 6} text-anchor="middle" font-size="10" fill="#5d6380">1,70 m</text>
  </svg>
  <figcaption class="small muted">
    {items.map((f, i) => <span><i style={`background:${colors[i % 4]}`} /> {f.name}</span>)}
  </figcaption>
</figure>
<style>
  .sil { margin: 0; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; }
  .sil svg { width: 100%; max-height: 380px; }
  figcaption { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }
  figcaption i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 4px; }
</style>
