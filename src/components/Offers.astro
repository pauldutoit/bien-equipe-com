---
import { amazonFor, type Fridge } from "../lib/catalog";
import amazonJson from "../data/amazon.json";
const { f } = Astro.props as { f: Fridge };
const q = encodeURIComponent(f.ref);
// Amazon toujours en lien affilié et en premier : fiche produit si l'ASIN de la référence (ou d'une variante)
// est connu, sinon recherche Amazon taguée. Puis liens directs : fiches marchands retrouvées, site officiel, recherches.
const amazon = amazonFor(f);
const amazonSearch = `https://www.amazon.fr/s?k=${encodeURIComponent(f.brand + " " + f.ref)}&tag=${amazonJson.tag}`;
const shops = f.offers.filter((o) => !o.official);
const official = f.offers.filter((o) => o.official).slice(0, 1);
const found = new Set(shops.map((o) => o.merchant));
const searches = [
  { key: "darty", name: "Darty", url: `https://www.darty.com/nav/recherche?text=${q}` },
  { key: "boulanger", name: "Boulanger", url: `https://www.boulanger.com/resultats?tr=${q}` },
].filter((s) => !found.has(s.key));
---
<div class="offers">
  {amazon ? (
    <a class="offer" href={amazon.url} rel="sponsored nofollow noopener" target="_blank">
      <span><b>Amazon</b><br /><span class="small muted">Fiche produit{amazon.ref !== f.ref ? ` (${amazon.ref})` : ""}</span></span>
      <span class="btn small">Voir sur Amazon</span>
    </a>
  ) : (
    <a class="offer" href={amazonSearch} rel="sponsored nofollow noopener" target="_blank">
      <span><b>Amazon</b><br /><span class="small muted">Rechercher la référence</span></span>
      <span class="btn small">Chercher sur Amazon</span>
    </a>
  )}
  {shops.map((o) => (
    <a class="offer" href={o.url} rel="nofollow noopener" target="_blank">
      <span><b>{o.merchantName}</b><br /><span class="small muted">Fiche produit{o.ref ? ` (${o.ref})` : ""}</span></span>
      <span class="btn small">Voir le prix</span>
    </a>
  ))}
  {official.map((o) => (
    <a class="offer" href={o.url} rel="nofollow noopener" target="_blank">
      <span><b>{o.merchantName}</b><br /><span class="small muted">Site officiel de la marque</span></span>
      <span class="btn ghost small">Voir</span>
    </a>
  ))}
  {searches.map((s) => (
    <a class="offer" href={s.url} rel="nofollow noopener" target="_blank">
      <span><b>{s.name}</b><br /><span class="small muted">Rechercher la référence</span></span>
      <span class="btn ghost small">Chercher</span>
    </a>
  ))}
  <p class="small muted" style="margin:6px 0 0">Le lien Amazon est un lien affilié : nous touchons une petite commission si vous achetez, sans surcoût pour vous et sans effet sur la note. Les autres liens sont directs. Les prix changent souvent : vérifiez la référence exacte ({f.ref}) avant d'acheter.</p>
</div>
<style>
  .offers { display: flex; flex-direction: column; gap: 8px; }
  .offer { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; text-decoration: none; color: var(--ink); background: #fff; }
  .offer:hover { border-color: var(--blue); }
</style>
