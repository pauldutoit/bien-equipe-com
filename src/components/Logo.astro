---
// Cadran de note (arc + aiguille jaune) : même logo que la chaîne YouTube Bien Équipé.
const { size = 36 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 42 42" aria-hidden="true">
  <rect width="42" height="42" rx="12" fill="#3b5bff" />
  <g transform="translate(6 6)">
    <path d="M4.5 20 A10.5 10.5 0 0 1 25.5 20" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" />
    <path d="M15 20 L21.5 11.5" stroke="#ffd23f" stroke-width="3" stroke-linecap="round" />
    <circle cx="15" cy="20" r="2.6" fill="#fff" />
    <path d="M8 25.5 H22" stroke="#fff" stroke-opacity="0.55" stroke-width="2" stroke-linecap="round" />
  </g>
</svg>
