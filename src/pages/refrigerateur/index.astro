---
import RankingPage from "../../components/RankingPage.astro";
import { fridges, sortDefault, FACETS, facetItems, YEAR } from "../../lib/catalog";
const items = [...fridges].sort(sortDefault);
const types = FACETS.filter((f) => f.group === "Type").map((fc) => ({ fc, n: facetItems(fc).length }));
---
<RankingPage
  title={`Meilleur réfrigérateur ${YEAR} : ${items.length} modèles notés sur données officielles`}
  description={`Classement de ${items.length} réfrigérateurs vendus en France, notés sur leur consommation, leur bruit, leur volume utile et leurs équipements, d'après la base officielle EPREL.`}
  h1={`Meilleur réfrigérateur ${YEAR} : notre classement`}
  intro={`Nous avons noté ${items.length} réfrigérateurs vendus en France avec la même règle pour tous, à partir des données que chaque fabricant doit déclarer pour l'étiquette énergie : consommation, bruit, volumes, dimensions. Commencez par le format qui rentre chez vous.`}
  items={items}
  crumbs={[{ label: "Réfrigérateurs" }]}
>
  <section>
    <h2>Quel type de réfrigérateur ?</h2>
    <div class="grid grid-4">
      {types.map(({ fc, n }) => (
        <a class="card" href={`/refrigerateur/${fc.slug}/`} style="text-decoration:none;color:inherit">
          <h3 style="margin-bottom:4px">{fc.short}</h3>
          <p class="small muted" style="margin:0">{n} modèles</p>
        </a>
      ))}
    </div>
  </section>
</RankingPage>
